# App Node (Hostinger ou local) — NÃO use na VPS do Postgres

PORT=3000

# IP ou hostname da VPS onde roda o docker compose (só o banco)
DATABASE_URL=postgresql://brazug:SENHA@IP_DA_VPS:5432/brazug

# Ou variáveis separadas:
# POSTGRES_HOST=IP_DA_VPS
# POSTGRES_PORT=5432
# POSTGRES_USER=brazug
# POSTGRES_PASSWORD=SENHA
# POSTGRES_DB=brazug

TWITCH_CLIENT_ID=seu_client_id
TWITCH_CLIENT_SECRET=seu_client_secret
ADMIN_PASSWORD=senha_forte_admin_aqui
JWT_SECRET=segredo_longo_e_aleatorio_para_assinar_tokens
# OAuth opcional (login social)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Battle.net usa BLIZZARD_CLIENT_ID e BLIZZARD_CLIENT_SECRET
# Redirects: {BASE_URL}/api/auth/discord/callback e {BASE_URL}/api/auth/battlenet/callback
NODE_ENV=production

# Configurações de E-mail (SMTP)
SMTP_HOST=smtp.brazug.com
SMTP_PORT=465
SMTP_USER=noreply@brazug.com
SMTP_PASS=sua_senha_email_aqui
SMTP_SECURE=true
# Cópia (BCC) dos e-mails de cadastro para um endereço de segurança/auditoria (opcional)
# SECURITY_EMAIL=seguranca@brazug.com

# URL Base do Site (ex: https://brazug.com)
BASE_URL=http://localhost:3000
ARMORY_URL=http://localhost:3001
DISCORD_URL=https://discord.gg/brazug

# ── Admin API ──
ADMIN_API_KEY=gere_uma_chave_aleatoria_com_32_caracteres
ADMIN_API_KEY_NAME=X-API-Key
ADMIN_JWT_SCOPE=admin

# ── Bot Discord ──
DISCORD_BOT_TOKEN=token_do_bot_aqui
DISCORD_CLIENT_ID=client_id_do_bot_aqui

# ── Monitor Twitch ──
TWITCH_TAG_TO_MONITOR=brazug
TWITCH_CHECK_INTERVAL_MINUTES=2

