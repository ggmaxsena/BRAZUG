# App Node (Hostinger ou local) — NÃO use na VPS do Postgres

PORT=3000

# IP ou hostname da VPS onde roda o docker compose (só o banco)
DATABASE_URL=postgresql://brazug:SENHA@IP_DA_VPS:5432/brazug

# Ou variáveis separadas:
# POSTGRES_HOST=IP_DA_VPS
# POSTGRES_PORT=5432
# POSTGRES_USER=brazug
# POSTGRES_PASSWORD=SENHA
# POSTGRES_DB=brazug

TWITCH_CLIENT_ID=seu_client_id
TWITCH_CLIENT_SECRET=seu_client_secret
ADMIN_PASSWORD=senha_forte_admin_aqui
# Opcional: segredo alternativo para assinar tokens (fallback: JWT_SECRET)
# ADMIN_SECRET=
JWT_SECRET=segredo_longo_e_aleatorio_para_assinar_tokens
# OAuth opcional (login social)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Redirect: {BASE_URL}/api/auth/battlenet/callback
NODE_ENV=production

# Configurações de E-mail (SMTP)
SMTP_HOST=smtp.brazug.com
SMTP_PORT=465
SMTP_USER=noreply@brazug.com
SMTP_PASS=sua_senha_email_aqui
SMTP_SECURE=true

# URL Base do Site (ex: https://brazug.com)
BASE_URL=http://localhost:3000
ARMORY_URL=http://localhost:3001
DISCORD_URL=https://discord.gg/brazug

# Pasta de uploads (opcional; padrão: ./uploads)
# UPLOAD_DIR=

# Deathmap (estatísticas de mortes)
DEATHMAP_API_KEY=sua_chave_deathmap

# Spotify (opcional - player do rodapé)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_REDIRECT_URI={BASE_URL}/api/spotify/auth/callback

